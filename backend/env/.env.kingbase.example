# Experimental PostgreSQL-compatible KingbaseES configuration; copy to .env.dev/.env.prod.
# Requires: uv sync --extra kingbase
DATABASE_TYPE=kingbase
DATABASE_HOST=127.0.0.1
DATABASE_PORT=54321
DATABASE_USER=your_database_user
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=res-nexus
DATASOURCES={"logs":{"database":"res-nexus-log"}}
SECRET_KEY=replace_with_a_random_secret
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
# Create both databases and grant application/schema privileges before starting.
